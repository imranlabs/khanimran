<div class="mt-5">
      <a href="/Imran_Khan_Resume.pdf" download class="btn ml-3" >Download Résumé
      <a class="btn ml-3" href="https://www.linkedin.com/in/imrankahn/" target="_blank"> Let's connect!</a>
      <a href="https://github.com/imranlabs" target="_blank" class="btn ml-3">
        github
      </a>

<div style="height: 20px;"></div>
<div class="text-2xl font-bold"> Featured Projects</div>
<!--April-21-2026-project-5-->
 <HorizontalCard
  title="SEM Image Quality Assessment Web App"
  img="/files/images/projects/iqm_app/app_ico.jpg"
    desc={`Full-stack web application for SEM imaging sensor diagnostics, 
    implementing full-reference (SSIM, PSNR) and no-reference 
    (BRISQUE, Laplacian sharpness, FFT high-frequency energy) image quality 
    metrics with interactive visualizations. Dockerized FastAPI backend on 
    Render and Streamlit frontend on Streamlit Community Cloud, 
    deployed across a two-repo architecture`}
  url="projects/iqm_app"
  
  badge="FastAPI | Streamlit | Docker | OpenCV | SEM Metrology"
/>
<HorizontalCard
  title="SEM Microstructure Segmentation with U-Net"
  img="/files/images/projects/sem_img_segment/seg_ico.png"
    desc={`Semantic segmentation pipeline for SEM microstructure images using U-Net. 
        Implemented both a U-Net model from scratch and a pretrained ResNet34 encoder via transfer learning. 
        Addressed class imbalance with weighted Cross-Entropy and Dice loss, and evaluated performance using 
        mIoU, Dice score, confusion matrix, and boundary analysis.`}
  url="projects/sem_img_seg"
  badge="5-Class Semantic Segmentation (U-Net / ResNet34)"
/>

