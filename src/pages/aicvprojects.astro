---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const page = {
  title: "Imran Khan | Imaging , AI & Optics",
  description:
    "Ph.D. physicist specializing Physicist specializing in Computer Vision, SEM Metrology, and AI.",
};

const sideBarActiveItemID = "prjects";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());


const last_posts = posts.slice(0, 3);


---

<BaseLayout page={page} sideBarActiveItemID={sideBarActiveItemID}>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Featured AI/CV projects {"</>"}</div>
  </div>

<div class="space-y-4">
  <!--Project-3-Nov-17-2025-->
  <HorizontalCard
    title="Chest X-Ray Pneumonia Classification"
    img="/files/images/projects/chest_xray/X_ray_image.png"
    desc={`End-to-end exploration of pneumonia detection( Normal, Viral, and Bacterial) on chest X-rays using both
          classical machine learning(PCA, SVM) and deep convolutional networks and transfer learning(Resnet-50).`}
    url="projects/chestxray"
    badge="Multi-Class CNN (Normal / Viral / Bacterial)"
  />

 <div class="space-y-4">
  <!--Project-2-Nov-11-2025-->
  <HorizontalCard
    title="Automated Image Quality Assessment (IQA) for SEM Metrology"
    img="/files/images/projects/sem_iqa/sem_hero.jpg"
    desc={`SSIM,PSNR,for full reference image quality assesment . 
        Normalized Variance Focus Score (Normvar), and BRISQUE for No-reference. Domain specific quantification methods such as Histogram comparison and Frequency-domain (FFT)
        for SEM tool health assesment.`}
    url="/projects/sem_iqa"
    badge="SEM Metrology"
  />
    </div>
  <!--<div class="divider my-0"></div>-->
  <!--Project-1-Nov-4-2025-->
  <HorizontalCard
    title="California Housing Price Prediction"
    img="/files/images/projects/california_housing/hero.png"
    desc={`A rigorous, end-to-end machine learning
      workflow to predict median house values in California census block
      groups. The primary goal was to systematically compare the performance
      of diverse modeling techniques—from classical regression to advanced
      boosting.`}
    url="/projects/california_housing"
    badge="MLOPS"
  />
   
  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Featured research projects</div>
  </div>

<!--creation date Nov-18,2025--> 
<HorizontalCard
    title="Scattering by Nanoplasmonic Mesoscale Assemblies"
    img="/files/images/projects/scattering/schematic.png"
    desc={`Studied how gold nanoparticle shells reshape the angular scattering of dielectric microspheres. 
          Using a hybrid MFS + Foldy–Lax model, showed that AuNP coatings suppress Mie sidelobes 
          and enhance forward scattering through phase decoherence and plasmonic multiple scattering.`}
    url="/research/scattering"
    
    badge="Angular Scattering Modeling"
  />

  <HorizontalCard
    title="Modeling Broadband Cloaking Using Nano-Assembled Plasmonic Meta-Structures"
    img="/files/images/projects/broadbandscattering/broadband.png"
    desc={`Developed a hybrid computational model combining MFS and Foldy–Lax theory to study plasmonic nano-shells. 
          Demonstrated how dense AuNP coatings cancel Mie scattering through multipole interference, 
          enabling broadband optical cloaking and tunable far-field response.`}
    url="/research/broadbandscattering"
    
    badge="Computational EM | Plasmonics Cloaking"
  />

<!--creation date Nov-18,2025--> 
<HorizontalCard
    title="Experimental demonstration of Scattering Suppression in AuNP-Coated Dielectric Microspheres"
    img="/files/images/projects/cloakexperiment/exp_hero.png"
    desc={`Experimentally demonstrated scattering suppression in AuNP-coated silica microspheres through nano-fabrication, 
            SEM characterization, and integrating-sphere measurements. 
            Validated key trends predicted by plasmonic cloaking simulations, showing reduced scattering intensity in the 400–600 nm band.`}
    url="/research/cloakexperiment"
    
    badge="Experimental Optics | SEM"
  />

</BaseLayout>
